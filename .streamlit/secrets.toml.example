# Copy values into Streamlit Community Cloud → App settings → Secrets.
# Do not commit real credentials to GitHub.
SUPABASE_URL = "https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY"

# Optional persistent PostgreSQL database (e.g. Supabase Postgres).
# Add the private connection string only in deployment secrets; never commit it.
# DATABASE_URL = "postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
